# --------------------------
# Core Traits
# --------------------------

trait Printable
    fun repr() => str
        required


trait Truthy
    fun is_truthy() => bool
        required


trait Hashable
    pure fun hash() => int
        required


trait Sized
    fun size() => int
        required

    fun is_empty() => bool
        return self.size() == 0


template
    T: any
trait Indexable
    fun get(index: int) => T
        required

    fun set(index: int, value: T)
        required

# --------------------------
# The Core Four
# --------------------------

primitive bool is Printable & Truthy & Hashable
    fun repr() => str
        return if self then "true" else "false"

    fun is_truthy() => bool
        return self

    pure fun hash() => int
        return if self then 1 else 0


primitive int is Printable & Truthy & Hashable
    fun repr() => str
        return "{self}"

    fun is_truthy() => bool
        return self > 0

    pure fun hash() => int
        return self


primitive float is Printable & Truthy
    fun repr() => str
        return "{self}"

    fun is_truthy() => bool
        return self > 0


primitive str is Printable & Truthy & Hashable & Sized
    fun repr() => str
        return self

    fun is_truthy() => bool
        return self.size() > 0

    pure fun hash() => int
        native

    fun size() => int
        native

    fun slice(start: int, end: int) => str
        native

    fun trim() => str
        native

# --------------------------
# Aliases
# --------------------------

type num = int | float

let x = 4
x = x + 1
